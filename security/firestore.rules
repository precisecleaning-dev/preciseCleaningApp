rules_version = '2';

// =============================================================================
// PROPUESTA de Security Rules de Firestore — Precise Cleaning (auditoría H-01)
// -----------------------------------------------------------------------------
// NO está conectada a firebase.json a propósito: un `firebase deploy` no la
// publica. Antes de usarla lee security/README.md (orden de activación y
// decisiones que cambian lo que ve algún rol).
//
// Modelo: las mismas reglas que ya aplica la app, ahora en el servidor.
//   · Los permisos salen de user_access/{email}, un espejo por usuario que
//     mantienen las Cloud Functions (functions/src/userAccess.ts). Las reglas
//     no pueden leer settings_roles directamente (la lista de permisos es un
//     arreglo de objetos) ni encontrar system_users por uid (sus ids no son el
//     uid de Auth).
//   · "Ver" un módulo permite trabajar en él, como en la app de hoy. Solo
//     Houses (editar, borrar, agregar) y Task List (proyectos) distinguen más.
//   · Costo: ~1 lectura extra por petición (el get de user_access se cobra una
//     vez por petición; una consulta o un listener es UNA petición).
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- quién es
    function signedIn() {
      return request.auth != null && request.auth.token.email is string;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function accessPath() {
      return /databases/$(database)/documents/user_access/$(myEmail());
    }
    function acc() {
      return get(accessPath()).data;
    }
    // Usuario de la lista (system_users), con rol y no "Inactive".
    function active() {
      return signedIn() && exists(accessPath()) && acc().active == true;
    }
    function isAdmin() {
      return active() && acc().admin == true;
    }
    // right: 'v' ver · 'a' agregar · 'e' editar · 'd' borrar
    function canDo(module, right) {
      return active()
        && (acc().admin == true || acc().m.get(module, {}).get(right, false) == true);
    }
    function has(module) {
      return canDo(module, 'v');
    }
    // Task List con Scope "All" (o admin): ve las tareas de todos.
    function taskScopeAll() {
      return acc().admin == true || acc().m.get('Task List', {}).get('o', false) != true;
    }
    // Tarea propia: asignada a mí (sola o con más personas), creada por mí o
    // esperando mi OK. Las tareas nuevas guardan assignees y sus ids en
    // assigneeUserIds (para array-contains); las
    // de antes, una sola persona en assigneeUserId (la app lee las dos). Un
    // campo que falta da error y el || sigue con la siguiente condición.
    function myTask(task) {
      return acc().userId in task.assigneeUserIds
        || task.assigneeUserId == acc().userId
        || task.createdByUserId == acc().userId
        || task.approval.approverUserId == acc().userId;
    }
    // ¿La tarea está asignada a mí? (en cualquiera de los dos formatos)
    function assignedToMe(task) {
      return acc().userId in task.get('assigneeUserIds', [])
        || task.get('assigneeUserId', '') == acc().userId;
    }
    // Puede ver dinero (Payroll, Invoices, Clients Report, Owner/Manager o
    // Houses sin ocultar "financial"). Lo calcula userAccess.ts.
    function fin() {
      return active() && (acc().admin == true || acc().get('fin', false) == true);
    }
    // Data Import escribe en las colecciones de negocio (no en usuarios ni roles).
    function importer() {
      return has('Data Import');
    }

    // ------------------------------------------------------------- utilidades
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }
    function onlyChanges(keys) {
      return changed().hasOnly(keys);
    }
    function newEmail() {
      return request.resource.data.get('email', '').lower();
    }
    function oldEmail() {
      return resource.data.get('email', '').lower();
    }
    function rolePath(roleId) {
      return /databases/$(database)/documents/settings_roles/$(roleId);
    }
    // ¿Ese id de rol es el rol "Administrator"? (vacío o inexistente: no)
    function isAdminRole(roleId) {
      return roleId is string && roleId != '' && exists(rolePath(roleId))
        && get(rolePath(roleId)).data.get('name', '') == 'Administrator';
    }

    // ===================================================== permisos (espejo)
    match /user_access/{email} {
      allow read: if signedIn() && (email == myEmail() || isAdmin());
      allow write: if false; // solo las Cloud Functions (Admin SDK)
    }

    // ================================================== usuarios y roles
    match /system_users/{userId} {
      // Todos los usuarios activos ven nombres, equipos y asignaciones.
      allow read: if active();
      // Quien no es Administrator: no crea administradores, no toca a un
      // administrador, no cambia su propio rol y no pone SU correo en otro
      // usuario (el espejo user_access sale del correo: sería darse otro rol).
      allow create: if has('System Users')
        && (isAdmin()
            || (!isAdminRole(request.resource.data.get('roleId', ''))
                && newEmail() != myEmail()));
      allow update: if
        (has('System Users')
          && (isAdmin()
              || (!isAdminRole(resource.data.get('roleId', ''))
                  && (!('email' in changed()) || newEmail() != myEmail())
                  && (!('roleId' in changed())
                      || (oldEmail() != myEmail()
                          && newEmail() != myEmail()
                          && !isAdminRole(request.resource.data.get('roleId', '')))))))
        // Settings → asignar equipo a un empleado (SettingsView).
        || (has('Settings') && onlyChanges(['teamId']));
      allow delete: if has('System Users')
        && (isAdmin() || !isAdminRole(resource.data.get('roleId', '')));
    }

    match /settings_roles/{roleId} {
      allow read: if active();
      allow create: if has('Roles & Permissions')
        && (isAdmin() || request.resource.data.get('name', '') != 'Administrator');
      // Sin ser Administrator tampoco se edita el rol propio (sería darse
      // permisos a uno mismo). Ver D-8 en el README.
      allow update: if has('Roles & Permissions')
        && (isAdmin()
            || (roleId != acc().roleId
                && resource.data.get('name', '') != 'Administrator'
                && request.resource.data.get('name', '') != 'Administrator'));
      allow delete: if has('Roles & Permissions')
        && (isAdmin() || resource.data.get('name', '') != 'Administrator');
    }

    // ============================================================ catálogos
    function isCatalog(col) {
      return col in [
        'settings_statuses', 'settings_teams', 'settings_priorities',
        'settings_services', 'settings_products', 'settings_tax',
        'settings_places', 'settings_tasks', 'settings_categories',
        'settings_responsables', 'settings_payment_methods', 'settings_businesses'
      ];
    }
    match /{col}/{docId} {
      allow read: if isCatalog(col) && active();
      allow write: if isCatalog(col) && (has('Settings') || importer());
    }

    // "Edit checklist" del panel de Quality Check (módulo "QC Checklist Setup",
    // sin necesitar Settings): ordenar las áreas (solo `sortOrder`) y agregar,
    // renombrar (Edit) o archivar (Delete) tareas. Borrar sigue siendo de Settings.
    function checklistSetup(right) {
      return canDo('QC Checklist Setup', right);
    }
    function changedOnly(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }
    match /settings_places/{placeId} {
      allow update: if checklistSetup('e') && changedOnly(['sortOrder'])
        && request.resource.data.sortOrder is int;
    }
    match /settings_tasks/{taskId} {
      allow create: if checklistSetup('a')
        && request.resource.data.keys().hasOnly(['name', 'placeId', 'archived'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.placeId is string
        && request.resource.data.archived == false;
      allow update: if (checklistSetup('e') && changedOnly(['name'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0)
        || (checklistSetup('d') && changedOnly(['archived']) && request.resource.data.archived == true);
    }

    match /settings_company/{docId} {
      allow read: if active();
      allow write: if has('Company Settings') || importer();
    }

    match /app_settings/{docId} {
      allow read: if active();
      // photo_config (Settings / Photo Settings); houses_form_config (botón de
      // configurar campos del formulario de Houses: editar Roles & Permissions);
      // task_list_tabs (orden de las pestañas del Task list: editar Task List).
      // gcal_sync lo escriben solo las funciones.
      allow write: if docId != 'gcal_sync'
        && (has('Settings') || has('Photo Settings')
            || (docId == 'houses_form_config' && canDo('Roles & Permissions', 'e'))
            || (docId == 'task_list_tabs' && canDo('Task List', 'e')));
    }

    match /customers/{customerId} {
      allow read: if active();
      // Houses: "nuevo cliente" desde el formulario de la casa.
      allow create: if has('Customers') || canDo('Houses', 'a') || canDo('Houses', 'e') || importer();
      allow update: if has('Customers') || importer();
      allow delete: if has('Customers');
    }

    // ================================================================ casas
    // Campos que el equipo de campo escribe desde el detalle con solo "ver"
    // Houses: Start/Finish, notas, fotos.
    function fieldKeys() {
      return [
        'employeeStartedAt', 'employeeStartedBy', 'employeeStartedById',
        'employeeFinishedAt', 'employeeFinishedBy', 'employeeFinishedById',
        'notesHistory', 'note', 'employeeNote',
        'beforePhotos', 'afterPhotos', 'beforePhotosExcluded', 'afterPhotosExcluded'
      ];
    }
    // El historial de notas solo crece o se corrige (nunca se vacía).
    function notesKept() {
      return request.resource.data.get('notesHistory', []).size()
        >= resource.data.get('notesHistory', []).size();
    }
    // Quality Check mueve la casa (status, sello de Invoice, factura retenida).
    function qcKeys() {
      return ['statusId', 'sentToInvoiceAt', 'invoiceHold', 'invoiceHoldAt', 'invoiceHoldBy'];
    }

    match /properties/{houseId} {
      allow read: if active();
      allow create: if canDo('Houses', 'a')
        || has('Calendar')          // Calendar no distingue permisos (hoy crea)
        || has('Recycle Bin')       // restaurar desde la papelera
        || importer();
      // "Agregar" en Houses también actualiza: el alta escribe la casa en dos
      // pasos (crear y luego completar con fotos, sello de Invoice…). D-9.
      allow update: if canDo('Houses', 'e') || canDo('Houses', 'a')
        || has('Calendar')          // Calendar no distingue permisos (hoy edita)
        || importer()
        || (has('Quality Check') && onlyChanges(qcKeys()))
        || (has('Payroll') && onlyChanges(['scheduleDate']))       // Revisar fechas
        || (has('Houses') && onlyChanges(fieldKeys()) && notesKept())
        || (has('Office Notes') && onlyChanges(['officeNote', 'notesHistory']) && notesKept());
      // Borrar = mandar a la papelera (batch con trash): pide borrar en Houses.
      allow delete: if canDo('Houses', 'd');
    }

    match /billing_services/{serviceId} {
      allow read: if fin();
      allow create: if canDo('Houses', 'e') || canDo('Houses', 'a') || has('Recycle Bin') || importer();
      allow update: if canDo('Houses', 'e') || importer();
      allow delete: if canDo('Houses', 'e') || canDo('Houses', 'd');
    }

    match /payroll/{payId} {
      allow read: if fin();
      allow create: if has('Payroll') || canDo('Houses', 'e') || canDo('Houses', 'a') || has('Recycle Bin') || importer();
      allow update: if has('Payroll') || canDo('Houses', 'e') || importer();
      allow delete: if has('Payroll') || canDo('Houses', 'e') || canDo('Houses', 'd');
    }

    // Historial de status: se agrega, nunca se edita ni se borra.
    match /status_history/{entryId} {
      allow read: if active();
      allow create: if active();
      allow update, delete: if false;
    }

    match /checklists/{checklistId} {
      allow read: if active();
      allow create, update: if has('Houses') || has('Checklist');
      allow delete: if false;
    }

    match /damages/{damageId} {
      allow read: if active();
      allow write: if has('Houses');
    }

    // Colección vieja: solo lectura.
    match /recalls/{recallId} {
      allow read: if active();
      allow write: if false;
    }

    // ======================================================== Quality Check
    match /quality_checks/{qcId} {
      allow read: if active();
      // Manager → "Pass" rápido exige editar Quality Check (ya incluido).
      allow create, update: if has('Quality Check') || importer();
      allow delete: if has('Quality Check');
    }

    match /qc_routes/{routeId} {
      allow read, write: if has('Quality Check');
    }

    // Cola de correo (la despacha sendmailqueue). Solo al correo de la empresa:
    // así nadie la usa para mandar correos a terceros desde nuestro SMTP.
    match /mail/{mailId} {
      allow read: if active();
      allow create: if active()
        && request.resource.data.keys().hasOnly(['to', 'message'])
        && request.resource.data.to is string
        && request.resource.data.to.lower()
           == get(/databases/$(database)/documents/settings_company/main).data.get('email', '-').lower();
      allow update, delete: if false;
    }

    // ====================================================== bitácora y papelera
    match /activity_logs/{logId} {
      // La campana de notificaciones muestra las últimas 15 a todos.
      allow read: if active();
      allow create: if active();
      allow update, delete: if false;
    }

    match /trash/{trashId} {
      allow read: if has('Recycle Bin');
      // Solo casas, y solo en el mismo batch que borra la casa: así nadie
      // fabrica una entrada (p. ej. un usuario con rol de admin) para que un
      // administrador la "restaure".
      allow create: if canDo('Houses', 'd')
        && request.resource.data.collectionName == 'properties'
        && request.resource.data.originalId is string
        && exists(/databases/$(database)/documents/properties/$(request.resource.data.originalId))
        && !existsAfter(/databases/$(database)/documents/properties/$(request.resource.data.originalId));
      allow update: if false;
      allow delete: if has('Recycle Bin');
    }

    // ========================================================== Invoices New
    // Módulo "Invoices New" de Roles: View = lista, detalle, PDF y Activity ·
    // Add = crear · Edit = editar, notas, fotos y registrar el pago. Sin borrar
    // (el número no deja huecos). Lo que escribe el navegador sale de
    // src/services/invoicesService.ts; estas reglas repiten sus validaciones:
    //   · el número sale del contador del año, en la MISMA transacción;
    //   · montos en centavos: taxCents = round(subtotal × tasa / 10000) y
    //     totalCents = subtotal + tax;
    //   · el navegador solo pone los estados Awaiting Payment y Paid (pago
    //     manual completo); Payment Link Sent, Paid via Stripe y `delivery`
    //     los escribe solo el servidor (Admin SDK, no pasa por estas reglas);
    //   · pagado: subtotal, tasa y montos quedan fijos;
    //   · número, cliente, job y quién lo creó no cambian nunca.
    // Las listas (notas, fotos, cambios) no se recorren: su forma la valida el
    // service; aquí solo se limita su tamaño.
    function invoicePath(invoiceId) {
      return /databases/$(database)/documents/invoices/$(invoiceId);
    }
    function invoiceCounterPath(year) {
      return /databases/$(database)/documents/invoice_counters/$(year);
    }
    // Quien figura como autor es el usuario de la sesión. Administrator puede
    // usar "View As User" y entonces la app escribe el id de la otra persona.
    function byMe(userId) {
      return isAdmin() || userId == acc().userId;
    }
    function isYmd(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function invoiceIsPaid(invoice) {
      return invoice.status in ['paid', 'paid_via_stripe'];
    }
    // En la papelera (Delete): `deletion` no es null. Los invoices nuevos no
    // traen el campo (ausente = activo).
    function invoiceIsDeleted(invoice) {
      return invoice.get('deletion', null) != null;
    }
    // "INV-2026-0007": consecutivo con al menos 4 dígitos (invoiceMath.ts).
    function padSeq(seq) {
      return seq < 10 ? '000' + string(seq)
        : seq < 100 ? '00' + string(seq)
        : seq < 1000 ? '0' + string(seq)
        : string(seq);
    }
    // Lo que debe cumplir el invoice completo después de cualquier escritura.
    function invoiceFieldsOk(d) {
      return d.subtotalCents is int && d.subtotalCents >= 1
        && d.taxRateBps is int && d.taxRateBps >= 0 && d.taxRateBps <= 10000
        && d.taxCents is int && d.taxCents >= 0
        && d.feesCents is int && d.feesCents >= 0
        // Los montos salen de los servicios copiados del job y de los fees
        // (invoiceMath.computeInvoiceTotals). Las reglas no recorren listas:
        // validan la suma y el tamaño de cada lista; cada línea la valida el service.
        && d.totalCents == d.subtotalCents + d.taxCents + d.feesCents
        && d.lineItems is list && d.lineItems.size() >= 1 && d.lineItems.size() <= 50
        && d.fees is list && d.fees.size() <= 10
        && isYmd(d.issueDate) && isYmd(d.dueDate) && d.dueDate >= d.issueDate
        && d.paymentTerms in ['due_on_receipt', 'net_7', 'net_15', 'net_30', 'custom']
        && d.recipientEmail is string && d.recipientEmail.size() <= 254
        && (d.recipientEmail == '' || d.recipientEmail.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$'))
        && d.paymentLinkUrl is string && d.paymentLinkUrl.size() <= 2000
        // Solo Payment Links de Stripe: el enlace va en un correo a un cliente.
        && (d.paymentLinkUrl == '' || d.paymentLinkUrl.matches('^https://buy[.]stripe[.]com/\\S+$'))
        // Máximo de notas: INVOICE_LIMITS.maxNotes (invoicesService.ts).
        && d.notes is list && d.notes.size() <= 20
        && d.photos is map && d.photos.include is bool && d.photos.mode in ['all', 'selected']
        && d.updatedAt is string && byMe(d.updatedByUserId) && d.updatedByUserName is string;
    }
    // Pago manual completo (Mark as Paid o crear como Paid).
    function manualPaymentOk(p, d) {
      return p is map
        && p.keys().hasOnly(['source', 'method', 'paidDate', 'amountCents', 'reference', 'note',
          'recordedAt', 'recordedByUserId', 'recordedByUserName', 'stripePaymentIntentId', 'stripeEventId'])
        && p.source == 'manual'
        && p.method in ['Cash', 'Bank transfer', 'Check', 'Other']
        && isYmd(p.paidDate) && p.paidDate >= d.issueDate
        && p.amountCents == d.totalCents
        && p.reference is string && p.reference.size() <= 160
        && p.note is string && p.note.size() <= 1500
        && p.stripePaymentIntentId == null && p.stripeEventId == null
        // Quien registra el pago es quien guarda el cambio (updatedByUserId ya
        // pasa por byMe en invoiceFieldsOk): así no se evalúa byMe otra vez.
        && p.recordedAt is string && p.recordedByUserId == d.updatedByUserId;
    }
    // El número es el que dejó el contador del año en esta misma transacción.
    function invoiceNumberOk(d, invoiceId) {
      let counter = getAfter(invoiceCounterPath(string(d.numberYear))).data;
      return d.numberYear is int && d.numberSeq is int && d.numberSeq >= 1
        && d.numberYear >= request.time.year() - 1 && d.numberYear <= request.time.year() + 1
        && d.number == 'INV-' + string(d.numberYear) + '-' + padSeq(d.numberSeq)
        && d.numberKey == d.numberYear * 1000000 + d.numberSeq
        && counter.lastSeq == d.numberSeq && counter.lastInvoiceId == invoiceId;
    }
    function invoiceCreateOk(invoiceId) {
      let d = request.resource.data;
      let invoiceKeys = [
        'number', 'numberYear', 'numberSeq', 'numberKey', 'status', 'currency',
        'issueDate', 'paymentTerms', 'dueDate', 'lineItems', 'fees',
        'subtotalCents', 'taxRateBps', 'taxCents', 'feesCents', 'totalCents',
        'propertyId', 'customerId', 'business', 'client', 'job', 'jobAmountsAtIssue',
        'recipientEmail', 'notes', 'photos', 'payment', 'delivery', 'paymentLinkUrl', 'searchText',
        'createdAt', 'createdByUserId', 'createdByUserName', 'updatedAt', 'updatedByUserId', 'updatedByUserName'
      ];
      // Solo hasOnly (sin hasAll): cada campo obligatorio ya se valida abajo y
      // falta = error = no pasa. Las dos listas juntas pasaban el límite de 1000
      // expresiones por petición al crear como Paid.
      return d.keys().hasOnly(invoiceKeys)
        && invoiceFieldsOk(d) && invoiceNumberOk(d, invoiceId)
        && d.currency == 'USD'
        && d.business in ['Normal', 'Cavalry']
        && d.client is map && d.job is map
        && d.propertyId is string && d.job.propertyId == d.propertyId
        && exists(/databases/$(database)/documents/properties/$(d.propertyId))
        && d.customerId == d.client.customerId
        && d.searchText is string && d.searchText.size() <= 1000
        && d.delivery == {
          'sendCount': 0, 'lastAt': null, 'lastTo': '', 'lastIncludedPdf': false,
          'lastIncludedPaymentLink': false, 'lastResult': null
        }
        // Autor = updatedByUserId, que ya pasa por byMe en invoiceFieldsOk.
        && d.createdByUserId == d.updatedByUserId
        && d.createdAt == d.updatedAt
        && ((d.status in ['needs_invoice', 'pending'] && d.payment == null)
            || (d.status == 'paid' && manualPaymentOk(d.payment, d)));
    }
    // Campos de Edit Invoice, notas y fotos.
    function invoiceEditFields() {
      return [
        'issueDate', 'paymentTerms', 'dueDate', 'lineItems', 'fees',
        'subtotalCents', 'taxRateBps', 'taxCents', 'feesCents', 'totalCents',
        'recipientEmail', 'paymentLinkUrl', 'notes', 'photos', 'updatedAt', 'updatedByUserId', 'updatedByUserName'
      ];
    }
    // Edit Invoice, notas y fotos: fechas, servicios y fees (si no está pagado), correo,
    // enlace, notas y resumen de fotos. El estado solo va de Needs Invoice a
    // Pending o al revés (Payment Link Sent y los pagados no vuelven atrás).
    function invoiceEditOk() {
      return onlyChanges(invoiceEditFields().concat(['status']))
        && (!changed().hasAny(['status'])
            || (resource.data.status in ['needs_invoice', 'pending']
                && request.resource.data.status in ['needs_invoice', 'pending']))
        && (!invoiceIsPaid(resource.data)
            || !changed().hasAny(['lineItems', 'fees', 'subtotalCents', 'taxRateBps', 'taxCents', 'feesCents', 'totalCents']));
    }
    // Mark as Paid, o Paid elegido en Edit Invoice (con los demás cambios del
    // formulario): de sin pagar a Paid con el pago completo, una sola vez.
    function invoicePaymentOk() {
      return onlyChanges(invoiceEditFields().concat(['status', 'payment']))
        && !invoiceIsPaid(resource.data)
        && request.resource.data.status == 'paid'
        && manualPaymentOk(request.resource.data.payment, request.resource.data);
    }

    // Delete (papelera) y Restore, con el permiso Delete ('d'): solo cambian
    // `deletion` y quién / cuándo. Nunca un pagado. No pasa por invoiceFieldsOk:
    // así también se pueden mandar a la papelera los invoices de prueba viejos.
    function invoiceDeletionOk() {
      let after = request.resource.data;
      return canDo('Invoices New', 'd')
        && onlyChanges(['deletion', 'updatedAt', 'updatedByUserId', 'updatedByUserName'])
        && after.updatedAt is string && byMe(after.updatedByUserId)
        && !invoiceIsPaid(resource.data)
        && (after.deletion == null
            ? invoiceIsDeleted(resource.data)
            : !invoiceIsDeleted(resource.data)
              && after.deletion.keys().hasOnly(['deletedAt', 'deletedByUserId', 'deletedByUserName', 'reason'])
              && after.deletion.deletedAt is string
              && after.deletion.deletedByUserId == after.updatedByUserId
              && after.deletion.deletedByUserName is string
              && after.deletion.reason is string
              && after.deletion.reason.size() >= 1 && after.deletion.reason.size() <= 300);
    }

    match /invoices/{invoiceId} {
      allow read: if has('Invoices New');
      allow create: if canDo('Invoices New', 'a') && invoiceCreateOk(invoiceId);
      // Se evalúa UNO de los dos caminos (pasar a Paid o editar): evaluar los dos
      // pasaba el límite de 1000 expresiones por petición.
      // Un invoice en la papelera no se edita ni se paga hasta restaurarlo.
      allow update: if changed().hasAny(['deletion'])
        ? invoiceDeletionOk()
        : canDo('Invoices New', 'e') && !invoiceIsDeleted(resource.data)
          && invoiceFieldsOk(request.resource.data)
          && (request.resource.data.status == 'paid' && !invoiceIsPaid(resource.data)
              ? invoicePaymentOk()
              : invoiceEditOk());
      allow delete: if false;

      // Activity: solo se agrega. "created" va en la transacción que crea el
      // invoice; los demás, sobre un invoice que ya existía. (Las reglas no
      // pueden exigir que el evento viaje con su cambio: no conocen su id.)
      match /events/{eventId} {
        allow read: if has('Invoices New');
        allow create: if invoiceEventOk(invoiceId);
        allow update, delete: if false;
      }

      // Fotos elegidas para el PDF: un solo documento, `selection`.
      match /photos/{docId} {
        allow read: if has('Invoices New');
        allow create: if docId == 'selection' && invoicePhotosOk()
          && ((canDo('Invoices New', 'a') && !exists(invoicePath(invoiceId)) && existsAfter(invoicePath(invoiceId)))
              || (canDo('Invoices New', 'e') && exists(invoicePath(invoiceId))));
        allow update: if docId == 'selection' && canDo('Invoices New', 'e') && invoicePhotosOk();
        allow delete: if false;
      }
    }

    function invoiceEventOk(invoiceId) {
      let e = request.resource.data;
      let eventKeys = ['type', 'at', 'actorType', 'actorUserId', 'actorUserName', 'summary', 'changes'];
      let isNewInvoice = !exists(invoicePath(invoiceId));
      return e.keys().hasOnly(eventKeys) && e.keys().hasAll(eventKeys)
        && e.actorType == 'user' && byMe(e.actorUserId) && e.actorUserName is string
        && e.at is string && e.summary is string && e.summary.size() <= 500
        && e.changes is list && e.changes.size() <= 20
        && existsAfter(invoicePath(invoiceId))
        && ((isNewInvoice && canDo('Invoices New', 'a') && e.type in ['created', 'payment_recorded'])
            || (!isNewInvoice && canDo('Invoices New', 'e')
                && e.type in ['updated', 'note_added', 'photos_updated', 'payment_recorded'])
            || (!isNewInvoice && canDo('Invoices New', 'd') && e.type in ['deleted', 'restored']));
    }

    function invoicePhotosOk() {
      let s = request.resource.data;
      let selectionKeys = ['include', 'mode', 'items', 'updatedAt', 'updatedByUserId', 'updatedByUserName'];
      return s.keys().hasOnly(selectionKeys) && s.keys().hasAll(selectionKeys)
        && s.include is bool && s.mode in ['all', 'selected']
        && s.items is list && s.items.size() <= 1000
        && s.updatedAt is string && byMe(s.updatedByUserId);
    }

    // Consecutivo del año: lo lee y lo sube +1 la transacción que crea el
    // invoice, y solo si ese invoice nace en la misma transacción con ese número.
    function invoiceCounterOk(year) {
      let c = request.resource.data;
      return c.keys().hasOnly(['lastSeq', 'lastInvoiceId', 'updatedAt'])
        && c.lastSeq is int && c.lastInvoiceId is string && c.updatedAt is string
        && !exists(invoicePath(c.lastInvoiceId)) && existsAfter(invoicePath(c.lastInvoiceId))
        && getAfter(invoicePath(c.lastInvoiceId)).data.numberSeq == c.lastSeq
        && string(getAfter(invoicePath(c.lastInvoiceId)).data.numberYear) == year;
    }
    match /invoice_counters/{year} {
      allow read: if canDo('Invoices New', 'a');
      allow create: if canDo('Invoices New', 'a') && invoiceCounterOk(year) && request.resource.data.lastSeq == 1;
      allow update: if canDo('Invoices New', 'a') && invoiceCounterOk(year)
        && request.resource.data.lastSeq == resource.data.lastSeq + 1;
      allow delete: if false;
    }

    // ========================================================== Owner/Manager
    match /time_clock/{entryId} {
      allow read: if has('Owner') || has('Manager');
      // Cada quien marca su propia entrada y salida (admin: cualquiera).
      allow create: if (has('Owner') || has('Manager'))
        && (isAdmin() || request.resource.data.userId == acc().userId);
      allow update: if (has('Owner') || has('Manager'))
        && (isAdmin() || resource.data.userId == acc().userId)
        && resource.data.get('outAt', null) == null
        && onlyChanges(['outAt']);
      allow delete: if false;
    }

    // ============================================================= Task list
    // (antes ops_tasks, ops_projects y ops_priorities; comentarios dentro de
    // cada tarea y de cada proyecto)
    // Los comentarios van dentro de cada tarea (comments[]).
    // Scope de Task List en Roles: "Own" solo ve y cambia sus tareas (las que
    // tiene asignadas, las que creó y las que esperan su OK). Las consultas de
    // la app con "Own" siempre filtran por assigneeUserIds (array-contains),
    // assigneeUserId (tareas de antes), createdByUserId (pestaña "Assigned
    // by") o approval.approverUserId, así que las reglas las pueden comprobar.
    // Quién la asignó y cuándo (createdBy*, createdAt) no se cambia nunca. A
    // quiénes está asignada (assignee*, en los dos formatos) solo lo cambia
    // quien la asignó, o alguien con Edit si la tarea no es suya
    // (opsPermissions.canReassignTask).
    match /user_tasks/{taskId} {
      allow read, delete: if has('Task List') && (taskScopeAll() || myTask(resource.data));
      allow update: if has('Task List') && (taskScopeAll() || myTask(resource.data))
        && !changed().hasAny(['createdByUserId', 'createdByUserName', 'createdAt'])
        && (!changed().hasAny(['assignees', 'assigneeUserIds', 'assigneeUserId', 'assigneeUserName'])
          || resource.data.createdByUserId == acc().userId
          || (canDo('Task List', 'e') && !assignedToMe(resource.data)));
      allow create: if has('Task List');
    }

    match /task_projects/{projectId} {
      allow read: if has('Task List');
      // Los contadores (taskCount, doneCount, openMinutes) viajan en el batch
      // de cada tarea, y comentar es para todos: cualquiera con Task List los
      // ajusta. Lo demás del proyecto según el módulo "Projects" de Roles
      // (Add = crear, Edit = editar y cambiar estado, Delete = borrar); un rol
      // que no lo declara lo hereda de Task List (functions/src/userAccess.ts).
      allow update: if canDo('Projects', 'e')
        || (has('Task List') && onlyChanges(['taskCount', 'doneCount', 'openMinutes', 'comments']));
      allow create: if canDo('Projects', 'a');
      allow delete: if canDo('Projects', 'd');
    }

    match /user_priorities/{userId} {
      allow read, write: if has('Task List');
    }

    // Avisos: hoy solo los escribe Data Import (ninguna pantalla los lee).
    match /notice_board/{noticeId} {
      allow read: if active();
      allow write: if importer();
    }

    // Cualquier otra colección: cerrada.
  }
}
